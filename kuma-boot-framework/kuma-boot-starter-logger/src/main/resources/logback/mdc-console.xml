<?xml version="1.0" encoding="UTF-8"?>
<included>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="SERVER_PORT" source="server.port" defaultValue="8080"/>
    <springProperty scope="context" name="KMC_VERSION" source="kmcVersion" defaultValue="--"/>
    <springProperty scope="context" name="ACTIVE_PROFILES" source="spring.profiles.active" defaultValue=""/>
    <conversionRule conversionWord="localIp" class="com.kuma.boot.logger.logback.converter.LocalIpConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.kuma.boot.logger.logback.layout.TraceIdPatternLogbackLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level ${PID:-} [${APP_NAME}:%localIp:${SERVER_PORT}] [${KMC_VERSION}] [%thread] [${ACTIVE_PROFILES}] [${os.name}:${os.version}:${user.timezone}:${java.version}] Klog:[%X{klog:-}] TraceId:[%X{kmc-trace-id:-}] TenantId:[%X{kmc-tenant-id:-}] RequestVersion:[%X{kmc-request-version:-}] OtlpTraceId:[%X{traceId:-}:%X{spanId:-}] [%tid] %logger{80}:%L : %msg %kvp%n%wEx</pattern>
            </layout>
        </encoder>
    </appender>
</included>
