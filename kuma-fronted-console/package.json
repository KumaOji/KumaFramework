{
  "name": "kuma-fronted-console",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=22.12.0" },
  "description": "Kuma 本机监控桌面控制台",
  "author": "Kuma",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "node scripts/start-desktop.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer/desktop.js && node --check renderer/console.js && node --check renderer/project-catalog.js && node --check renderer/response-format.js",
    "test": "node --test scripts/response-format.test.cjs",
    "prepare:backend": "node scripts/build-backend.cjs",
    "pack": "pnpm run prepare:backend && electron-builder --dir",
    "dist": "pnpm run prepare:backend && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.kumaoji.console",
    "productName": "Kuma Console",
    "directories": { "output": "dist" },
    "files": ["electron/**", "package.json"],
    "extraResources": [{ "from": "../kuma-project/kuma-project-console/build/libs/kuma-console.jar", "to": "backend/kuma-console.jar" }],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "Kuma-Console-${version}.exe" }
  }
}
