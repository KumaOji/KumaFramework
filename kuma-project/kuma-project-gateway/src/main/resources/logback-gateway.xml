<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="kuma-cloud-gateway"/>
    <springProperty scope="context" name="ENVIRONMENT" source="gateway.environment" defaultValue="local"/>
    <springProperty scope="context" name="LOKI_URL" source="gateway.loki-url" defaultValue="http://localhost:3100/loki/api/v1/push"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service_name":"${APP_NAME}","environment":"${ENVIRONMENT}"}</customFields>
        </encoder>
    </appender>
    <!-- Loki4j 自带有界队列和后台批量 HTTP 发送，不在 Netty 线程同步发送日志。 -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <batchTimeoutMs>1000</batchTimeoutMs>
        <batchMaxItems>256</batchMaxItems>
        <batchMaxBytes>524288</batchMaxBytes>
        <sendQueueMaxBytes>4194304</sendQueueMaxBytes>
        <http>
            <url>${LOKI_URL}</url>
            <connectionTimeoutMs>1000</connectionTimeoutMs>
            <requestTimeoutMs>3000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>service_name=${APP_NAME},environment=${ENVIRONMENT}</pattern>
            </label>
            <message class="com.kuma.cloud.gateway.support.GatewayJsonLayout"/>
        </format>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <!-- 可通过启动参数关闭 Loki 上报，保留 JSON 控制台日志。 -->
    <springProfile name="observability &amp; !no-loki">
        <root level="INFO">
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
